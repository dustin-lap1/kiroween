# Values come from local.auto.tfvars, generated by scripts/Plan-App.ps1
# (gitignored: it holds the account id and your email).

variable "account_id" {
  description = "The app's own AWS account id. The provider refuses any other account."
  type        = string

  validation {
    condition     = can(regex("^[0-9]{12}$", var.account_id))
    error_message = "account_id must be a 12-digit AWS account id."
  }
}

variable "aws_profile" {
  description = "Local AWS CLI profile that assumes the app account's skeleton-deployer role."
  type        = string
}

variable "alert_email" {
  description = "Email for alarms and the budget alert. Empty disables the subscriptions."
  type        = string
  default     = ""
}

variable "monthly_budget_usd" {
  description = "Monthly cost budget for the account; alerts at 80% actual and 100% forecast."
  type        = number
  default     = 10
}

locals {
  # app.config.json is the single source of truth for the app: name, theme,
  # and the collections the API serves. Terraform, the Lambda, and the
  # frontend all read it.
  app  = jsondecode(file("${path.module}/../app.config.json"))
  name = local.app.name

  tags = {
    App       = local.app.name
    ManagedBy = "terraform"
    Project   = "kiroween-skeleton-crew"
  }
}
